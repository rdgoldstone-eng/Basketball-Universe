<script>
(function () {
  const BASE = 985;
  const shell = document.getElementById('scale-shell');
  const root  = document.getElementById('scale-root');
  if (!shell || !root) return;

  function applyScale() {
    // Only scale when viewport is narrower than BASE
    const vw = Math.min(window.innerWidth, document.documentElement.clientWidth || window.innerWidth);
    const s = Math.min(1, vw / BASE);

    if (vw >= BASE) {
      // Desktop / wide: disable scaling and let normal layout happen
      root.style.transform = '';
      root.style.position = '';
      shell.style.height = '';
      return;
    }

    // Mobile: scale legacy layout
    root.style.transform = `scale(${s})`;

    // Critical: set shell height to scaled content height
    // Use scrollHeight to include absolutely-positioned descendants reliably
    const h = root.scrollHeight * s;
    shell.style.height = Math.ceil(h) + 'px';
  }

  // Run on load + resize + after fonts/images settle
  window.addEventListener('resize', applyScale, { passive: true });
  window.addEventListener('orientationchange', applyScale, { passive: true });

  // First pass
  applyScale();

  // Second pass after layout stabilizes (images/ads can shift height)
  setTimeout(applyScale, 250);
  setTimeout(applyScale, 1000);
})();
</script>
