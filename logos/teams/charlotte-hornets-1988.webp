  /* Bar color */
  #nav { background-color: #262628 !important; }

  /* Core bar layout */
  #nav > .content > ul { display: flex; align-items: center; }
  #nav .sr-only { position: absolute; left: -9999px; }

  /* Icon strip */
  #nav .quickbar-li { display: flex; align-items: center; position: relative; }
  #nav .quickbar-strip {
    display: flex; align-items: center; gap: 18px;
    height: 100%;
    transform: translateY(-9px);
  }

  /* Links */
  #nav .qb-link {
    display: inline-flex; align-items: center; justify-content: center;
    height: 38px; padding: 0; background: transparent; border: 0;
    text-decoration: none; line-height: 0;
  }
  #nav .qb-link:focus-visible {
    outline: 2px solid rgba(255,255,255,.6); outline-offset: 2px; border-radius: 6px;
  }

  /* Icons */
  #nav .qb-link img {
    height: 34px; width: auto; display: block; object-fit: contain;
    transition: transform 120ms ease; transform-origin: center;
  }
  #nav .qb-link:hover img { transform: scale(1.5); }

  /* Featured event icons — thin white outline hugging the actual logo silhouette
     (not the bounding box), so dark-on-transparent logos read on the black nav. */
  #nav .qb-link--featured img {
    filter:
      drop-shadow( 1px  0   0 #fff)
      drop-shadow(-1px  0   0 #fff)
      drop-shadow( 0    1px 0 #fff)
      drop-shadow( 0   -1px 0 #fff);
  }

  /* Suppress any inherited hover backgrounds */
  #nav li:hover,
  #nav li:focus-within,
  #nav a:hover,
  #nav a:focus,
  #nav *:hover,
  #nav *:focus {
    background-color: transparent !important;
    filter: none !important;
    opacity: 1 !important;
    mix-blend-mode: normal !important;
    backdrop-filter: none !important;
    box-shadow: none !important;
  }
</style>

