		<div class="searchWrapper">

    <script>
        function validateForm() {
            var val = document.getElementById('search').value.trim();
            return val.length >= 1 && val.length <= 100;
        }

        document.addEventListener('DOMContentLoaded', function() {
            var searchForm   = document.getElementById('search-form');
            var searchInput  = document.getElementById('search');
            var searchButton = document.getElementById('search-button');
            var dropdown     = document.getElementById('search-dropdown');
            var acTimer      = null;
            var acIndex      = -1;
            var acItems      = [];

            // Move dropdown to <body> so it escapes overflow:hidden parents
            document.body.appendChild(dropdown);

            function _positionDropdown() {
                var rect = searchInput.getBoundingClientRect();
                dropdown.style.top   = (rect.bottom + 4) + 'px';
                dropdown.style.right = (window.innerWidth - rect.right) + 'px';
            }

            // ── Submit on Enter / button click ──────────────────────────────
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    acIndex = Math.min(acIndex + 1, acItems.length - 1);
                    _highlightItem();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    acIndex = Math.max(acIndex - 1, -1);
                    _highlightItem();
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (acIndex >= 0 && acItems[acIndex]) {
                        window.location.href = acItems[acIndex].dataset.url;
                    } else if (validateForm()) {
                        searchForm.submit();
                    }
                } else if (e.key === 'Escape') {
                    _closeDropdown();
                }
            });

            searchButton.addEventListener('click', function() {
                _closeDropdown();
                if (validateForm()) { searchForm.submit(); }
            });

            // ── Autocomplete ────────────────────────────────────────────────
            searchInput.addEventListener('input', function() {
                clearTimeout(acTimer);
                var q = this.value.trim();
                if (q.length < 2) { _closeDropdown(); return; }
                acTimer = setTimeout(function() { _fetchSuggestions(q); }, 280);
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!searchForm.contains(e.target)) { _closeDropdown(); }
            });

            function _fetchSuggestions(q) {
                fetch('/ajax/search.php?q=' + encodeURIComponent(q))
                    .then(function(r) { return r.json(); })
                    .then(function(items) { _renderDropdown(items, q); })
                    .catch(function() { _closeDropdown(); });
            }

            function _renderDropdown(items, q) {
                acIndex = -1;
                dropdown.innerHTML = '';
                if (!items.length) { _closeDropdown(); return; }

                items.forEach(function(item) {
                    var a = document.createElement('a');
                    a.href = item.url;
                    a.className = 'sln-ac-item';
                    a.dataset.url = item.url;

                    var img = document.createElement('img');
                    img.src = item.thumb_url || '';
                    img.alt = '';
                    img.className = 'sln-ac-thumb';
                    img.onerror = function() { this.style.visibility = 'hidden'; };

                    var text = document.createElement('span');
                    text.className = 'sln-ac-text';
                    text.innerHTML = '<span class="sln-ac-name">' + _esc(item.display_name) + '</span>'
                                   + '<span class="sln-ac-meta">' + _esc(item.meta) + '</span>';

                    a.appendChild(img);
                    a.appendChild(text);
                    dropdown.appendChild(a);
                });

                var all = document.createElement('a');
                all.href = '/search/?q=' + encodeURIComponent(q);
                all.className = 'sln-ac-all';
                all.textContent = 'See all results for \u201c' + q + '\u201d';
                dropdown.appendChild(all);

                acItems = dropdown.querySelectorAll('.sln-ac-item');
                _positionDropdown();
                dropdown.classList.add('sln-ac-open');
            }

            window.addEventListener('scroll', function() {
                if (dropdown.classList.contains('sln-ac-open')) { _positionDropdown(); }
            }, { passive: true });
            window.addEventListener('resize', function() {
                if (dropdown.classList.contains('sln-ac-open')) { _positionDropdown(); }
            });

            function _highlightItem() {
                acItems.forEach(function(el, i) {
                    el.classList.toggle('sln-ac-active', i === acIndex);
                });
            }

            function _closeDropdown() {
                dropdown.classList.remove('sln-ac-open');
                dropdown.innerHTML = '';
                acIndex = -1;
                acItems = [];
            }

            function _esc(s) {
                return String(s)
                    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }
        });
    </script>



    <form id="search-form" action="/search/" method="get" onsubmit="return validateForm();" style="position:relative;">
        <div class="sln-search-wrap">
            <input type="text" id="search" name="q" maxlength="100"
                   placeholder="Search teams, leagues, players, news…"
                   autocomplete="off"
                   value="" />
            <button type="button" id="search-button" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
        </div>
        <div id="search-dropdown" class="sln-ac-dropdown"></div>
    </form>
