(function () {
  // Target the auth slot in the new #sln-topnav-right layout, with a fallback
  // to the legacy #auth-nav in case any CI3 view still ships the old markup.
  var nav = document.getElementById('sln-auth-slot') || document.getElementById('auth-nav');
  if (!nav) return;

  var path = window.location.pathname + window.location.search;

  fetch('/google-auth/status.php?return=' + encodeURIComponent(path) + '&_=' + Date.now(), {
    credentials: 'include'
  })
    .then(function (r) { return r.text(); })
    .then(function (html) {
      nav.innerHTML = html;
    })
    .catch(function () {
