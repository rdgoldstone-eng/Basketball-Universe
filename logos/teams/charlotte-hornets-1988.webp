<script>
  // 1) Click handler (unchanged logic)
  document.getElementById('favBtn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const logoId = btn.dataset.logoId;

    const fd = new FormData();
    fd.append('logo_id', logoId);
    fd.append('action', 'toggle');

    const r = await fetch('/ajax/favourite-logo.php', {
      method: 'POST',
      credentials: 'include',
      body: fd
    });

    if (r.status === 401) {
      location.href = '/google-auth/login.php?return=' +
        encodeURIComponent(location.pathname + location.search);
      return;
    }

    const j = await r.json().catch(() => null);
    if (!j || !j.ok) return;

    btn.dataset.favourited = j.favourited ? '1' : '0';
    btn.classList.toggle('is-fav', j.favourited);
    btn.querySelector('.label').textContent =
      j.favourited ? 'Favourited' : 'Favourite';
    btn.setAttribute('aria-pressed', j.favourited ? 'true' : 'false');
  });

  // 2) On load, ask the server whether this logo is already favourited
  (async function initFavouriteState() {
    const btn = document.getElementById('favBtn');
    if (!btn) return;

    const logoId = btn.dataset.logoId;
    if (!logoId) return;

    const fd = new FormData();
    fd.append('logo_id', logoId);
    fd.append('action', 'status');

    const r = await fetch('/ajax/favourite-logo.php', {
      method: 'POST',
      credentials: 'include',
      body: fd
    });

    if (r.status === 401) {
      // Not logged in: leave as plain "Favourite"
      return;
    }

    const j = await r.json().catch(() => null);
    if (!j || !j.ok || typeof j.favourited === 'undefined') return;

    btn.dataset.favourited = j.favourited ? '1' : '0';
    btn.classList.toggle('is-fav', j.favourited);
    btn.querySelector('.label').textContent =
      j.favourited ? 'Favourited' : 'Favourite';
    btn.setAttribute('aria-pressed', j.favourited ? 'true' : 'false');
  })();
</script>

