<script>
$(function () {
    var $toggle = $('#related-links-toggle');
    var $grid   = $('#related-links-grid');

    if ($toggle.length && $grid.length) {
        $toggle.data('expanded', false);

        $toggle.on('click', function (e) {
            e.preventDefault();

            var expanded = $toggle.data('expanded') === true;

            $grid.stop(true, true).slideToggle(200, function () {
                // After opening, restore grid layout (jQuery sets display:block)
                if ($grid.is(':visible')) {
                    $grid.css('display', 'grid');
                }
            });

            if (expanded) {
                $toggle.text('More [+]');
            } else {
                $toggle.text('Less [-]');
            }

            $toggle.data('expanded', !expanded);
        });
    }
});
</script>
