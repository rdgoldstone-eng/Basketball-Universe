<div class="ratingblock" data-logo-id="3097"><div id="unit_long3097"><ul id="unit_ul3097" class="unit-rating" style="width:300px;"><li class="current-rating" style="width:195px;">Currently 6.50/10</li></ul><p style="color:#000000;">Rating: <strong>6.5</strong>/10 (1017 votes cast) &mdash; <a href="/google-auth/login.php?return=%2Flogos%2Fview%2F3097%2FCharlotte-Hornets-Logo%2F1989%2FPrimary-Logo">Log in to rate</a></p></div></div>
<script>
(function () {
  function bindRaters() {
    document.querySelectorAll(".unit-rating .rater").forEach(function (link) {
      if (link.dataset.ratingBound) return;
      link.dataset.ratingBound = "1";

      link.addEventListener("click", function (e) {
        e.preventDefault();
        var block  = this.closest(".ratingblock");
        var logoId = block ? block.dataset.logoId : "";
        var value  = parseInt(this.dataset.value, 10);
        if (!logoId || !value) return;

        var fd = new FormData();
        fd.append("logo_id", logoId);
        fd.append("rating",  value);

        fetch("/rate_logo.php", {
          method: "POST",
          credentials: "include",
          body: fd
        })
        .then(function (r) {
          if (r.status === 401) {
            window.location.href = "/google-auth/login.php?return=" +
              encodeURIComponent(window.location.pathname);
            return null;
          }
          return r.json();
        })
        .then(function (data) {
          if (!data || !data.success) return;

          var block = document.querySelector(".ratingblock[data-logo-id=\"" + logoId + "\"]");
          if (!block) return;

          block.dataset.userRating = data.user_rating;

          // Highlight the newly selected rating
          block.querySelectorAll(".rater").forEach(function (a) {
            a.classList.toggle("active-rating",
              parseInt(a.dataset.value, 10) === parseInt(data.user_rating, 10));
          });

          // Update the bar width (30 px per unit)
          var barLi = block.querySelector(".current-rating");
          if (barLi) barLi.style.width = (parseFloat(data.new_average) * 30) + "px";

          // Update the summary text
          var p = block.querySelector("p");
          if (p) {
            var tense = data.new_count === 1 ? "vote" : "votes";
            p.className = "voted";
            p.innerHTML = "Rating: <strong>" + data.new_average + "</strong>/10"
              + " (" + data.new_count + " " + tense + " cast)"
              + " &mdash; Your rating: <strong>" + data.user_rating + "</strong>";
          }
        })
        .catch(function () {});
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindRaters);
  } else {
    bindRaters();
  }
}());
</script>
        </div>
    </div>




